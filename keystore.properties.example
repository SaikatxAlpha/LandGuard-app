# LandGuard release signing — template.
#
# Copy this file to `keystore.properties` at the repository root and fill in the
# real values. `keystore.properties` and everything under `keystore/` are listed
# in .gitignore and MUST NEVER be committed or shared.
#
# To create a fresh release keystore:
#
#   keytool -genkeypair -v \
#     -keystore keystore/landguard-release.jks \
#     -alias landguard-release \
#     -keyalg RSA -keysize 4096 -validity 10950
#
# If `keystore.properties` is absent, the release build falls back to the debug
# signing key so the project still compiles for contributors and CI. Such a build
# is NOT distributable — only a build signed with the real release key is.
#
# CI: instead of a file, set the environment variables
# LANDGUARD_STORE_FILE, LANDGUARD_STORE_PASSWORD, LANDGUARD_KEY_ALIAS,
# LANDGUARD_KEY_PASSWORD as encrypted secrets.

storeFile=keystore/landguard-release.jks
storePassword=CHANGE_ME
keyAlias=landguard-release
keyPassword=CHANGE_ME
