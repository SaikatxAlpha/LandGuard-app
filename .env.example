# LandGuard Service Configuration Example
# Copy this file to .env or local.properties for local backend integrations.

# Backend API Base Route
LANDGUARD_API_BASE_URL=https://api.landguard.org
LANDGUARD_API_VERSION=v1

# Demo Data Policy
MOCK_MODE=true

# External Satellite Provider Gateway Routes (Handled Server-Side Only)
CDSE_CLIENT_ID=your_backend_cdse_client_id
CDSE_CLIENT_SECRET=your_backend_cdse_client_secret
SENTINEL_HUB_INSTANCE_ID=your_backend_sentinel_hub_instance_id
JAXA_GPORTAL_API_TOKEN=your_backend_jaxa_gportal_token

# Map Tile Server Configuration (Default: OpenFreeMap Liberty)
OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
