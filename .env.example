# LandGuard Android — service configuration reference.
#
# The app talks to ONE backend, the same one the authority control center uses:
#   https://api.landguard.online/   (BuildConfig.LANDGUARD_API_BASE_URL, app/build.gradle.kts)
# Release builds always use it; debug builds can override it from More → Server connection.
LANDGUARD_API_BASE_URL=https://api.landguard.online/

# Push alerts arrive through Firebase Cloud Messaging (app/google-services.json,
# project landguard-a4620). Firebase Admin credentials live on the backend only.

# Public data sources used directly only when the backend is unreachable (no keys needed):
#   NASA Global Landslide Catalog (ArcGIS), Open-Meteo, Microsoft Planetary Computer.

# Map tile server (default: OpenFreeMap Liberty)
OPENFREEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
