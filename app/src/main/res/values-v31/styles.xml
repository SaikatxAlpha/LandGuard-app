<resources>
    <style name="Theme.LandGuard" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/landguard_forest_night</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/landguard_forest_night</item>
        <item name="android:navigationBarColor">@color/landguard_forest_night</item>
        <!-- Android 12+ system launch screen hands off seamlessly to the in-app splash. -->
        <item name="android:windowSplashScreenBackground">@color/landguard_forest_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
